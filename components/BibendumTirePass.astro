<section class="bibendum-shell">
  <div class="headline">
    <p>TBL2 in motion</p>
    <h2>TBL2 passes from one Michelin side to the other</h2>
  </div>

  <div class="speed-halo"></div>
  <div class="speed-line s1"></div>
  <div class="speed-line s2"></div>
  <div class="speed-line s3"></div>

  <div class="bibendum-wrap left-bib" aria-label="Michelin Bibendum throwing the TBL2 tire">
    <svg class="bibendum-svg" viewBox="0 0 430 610" role="img">
      <defs>
        <linearGradient id="bodyLeft" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="58%" stop-color="#f4f6fa"/>
          <stop offset="100%" stop-color="#cfd5df"/>
        </linearGradient>
        <radialGradient id="faceLeft" cx="35%" cy="22%" r="85%">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="70%" stop-color="#f1f4f8"/>
          <stop offset="100%" stop-color="#c7ced9"/>
        </radialGradient>
        <filter id="softShadowLeft" x="-30%" y="-30%" width="160%" height="180%">
          <feDropShadow dx="0" dy="15" stdDeviation="11" flood-color="#000814" flood-opacity=".34"/>
        </filter>
      </defs>

      <g class="bib-bob" filter="url(#softShadowLeft)">
        <ellipse cx="208" cy="560" rx="108" ry="22" fill="#00142f" opacity=".38"/>

        <!-- legs -->
        <g class="leg-left">
          <ellipse cx="145" cy="431" rx="48" ry="38" fill="url(#bodyLeft)"/>
          <ellipse cx="138" cy="468" rx="45" ry="35" fill="url(#bodyLeft)"/>
          <ellipse cx="132" cy="503" rx="42" ry="33" fill="url(#bodyLeft)"/>
          <ellipse cx="120" cy="539" rx="54" ry="23" fill="url(#bodyLeft)"/>
        </g>
        <g class="leg-right">
          <ellipse cx="254" cy="422" rx="51" ry="39" fill="url(#bodyLeft)"/>
          <ellipse cx="265" cy="459" rx="47" ry="36" fill="url(#bodyLeft)"/>
          <ellipse cx="277" cy="493" rx="43" ry="33" fill="url(#bodyLeft)"/>
          <ellipse cx="292" cy="529" rx="58" ry="24" fill="url(#bodyLeft)"/>
        </g>

        <!-- torso rings -->
        <ellipse cx="205" cy="205" rx="103" ry="53" fill="url(#bodyLeft)"/>
        <ellipse cx="205" cy="246" rx="117" ry="56" fill="url(#bodyLeft)"/>
        <ellipse cx="205" cy="291" rx="126" ry="60" fill="url(#bodyLeft)"/>
        <ellipse cx="205" cy="338" rx="118" ry="57" fill="url(#bodyLeft)"/>
        <ellipse cx="205" cy="382" rx="101" ry="50" fill="url(#bodyLeft)"/>

        <!-- rear arm -->
        <g transform="rotate(32 112 255)">
          <ellipse cx="98" cy="233" rx="37" ry="46" fill="url(#bodyLeft)"/>
          <ellipse cx="77" cy="270" rx="34" ry="43" fill="url(#bodyLeft)"/>
          <ellipse cx="55" cy="304" rx="31" ry="39" fill="url(#bodyLeft)"/>
          <circle cx="39" cy="336" r="30" fill="url(#bodyLeft)"/>
        </g>

        <!-- throwing arm -->
        <g class="throw-arm" transform-origin="279px 236px">
          <ellipse cx="296" cy="233" rx="41" ry="48" fill="url(#bodyLeft)"/>
          <ellipse cx="330" cy="253" rx="38" ry="45" fill="url(#bodyLeft)"/>
          <ellipse cx="360" cy="277" rx="35" ry="41" fill="url(#bodyLeft)"/>
          <ellipse cx="391" cy="297" rx="33" ry="28" fill="url(#bodyLeft)"/>
          <circle cx="416" cy="291" r="10" fill="url(#bodyLeft)"/>
          <circle cx="414" cy="306" r="9" fill="url(#bodyLeft)"/>
          <circle cx="407" cy="319" r="8" fill="url(#bodyLeft)"/>
        </g>

        <!-- head -->
        <path d="M142 156 C128 113 143 64 182 40 C217 18 267 26 291 60 C312 90 307 130 283 157 C259 184 223 195 188 186 C166 181 151 170 142 156Z" fill="url(#faceLeft)"/>
        <ellipse cx="185" cy="102" rx="15" ry="21" fill="#fff" stroke="#9aa6b5" stroke-width="3"/>
        <ellipse cx="241" cy="98" rx="15" ry="21" fill="#fff" stroke="#9aa6b5" stroke-width="3"/>
        <ellipse cx="187" cy="105" rx="7" ry="11" fill="#0b1220"/>
        <ellipse cx="239" cy="101" rx="7" ry="11" fill="#0b1220"/>
        <circle cx="184" cy="100" r="2.5" fill="#fff"/>
        <circle cx="236" cy="96" r="2.5" fill="#fff"/>
        <path d="M175 137 Q216 166 258 132" fill="none" stroke="#273244" stroke-width="5" stroke-linecap="round"/>
        <path d="M199 121 Q212 128 226 120" fill="none" stroke="#9aa6b5" stroke-width="3" stroke-linecap="round"/>

        <!-- sash -->
        <g transform="rotate(-32 205 265)">
          <rect x="116" y="237" width="222" height="44" rx="17" fill="#003b8f" stroke="#ffd900" stroke-width="4"/>
          <text x="227" y="267" text-anchor="middle" fill="#fff" font-size="28" font-weight="900" font-family="Arial, Helvetica, sans-serif">MICHELIN</text>
        </g>
      </g>
    </svg>
  </div>

  <div class="bibendum-wrap right-bib" aria-label="Michelin Bibendum receiving the TBL2 tire">
    <svg class="bibendum-svg" viewBox="0 0 430 610" role="img">
      <defs>
        <linearGradient id="bodyRight" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="58%" stop-color="#f4f6fa"/>
          <stop offset="100%" stop-color="#cfd5df"/>
        </linearGradient>
        <radialGradient id="faceRight" cx="35%" cy="22%" r="85%">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="70%" stop-color="#f1f4f8"/>
          <stop offset="100%" stop-color="#c7ced9"/>
        </radialGradient>
        <filter id="softShadowRight" x="-30%" y="-30%" width="160%" height="180%">
          <feDropShadow dx="0" dy="15" stdDeviation="11" flood-color="#000814" flood-opacity=".34"/>
        </filter>
      </defs>

      <g class="bib-bob right-bob" filter="url(#softShadowRight)">
        <ellipse cx="218" cy="560" rx="108" ry="22" fill="#00142f" opacity=".38"/>

        <g>
          <ellipse cx="165" cy="426" rx="49" ry="38" fill="url(#bodyRight)"/>
          <ellipse cx="156" cy="465" rx="45" ry="35" fill="url(#bodyRight)"/>
          <ellipse cx="148" cy="501" rx="42" ry="33" fill="url(#bodyRight)"/>
          <ellipse cx="135" cy="537" rx="55" ry="23" fill="url(#bodyRight)"/>
        </g>
        <g>
          <ellipse cx="270" cy="428" rx="49" ry="38" fill="url(#bodyRight)"/>
          <ellipse cx="279" cy="467" rx="45" ry="35" fill="url(#bodyRight)"/>
          <ellipse cx="286" cy="503" rx="42" ry="33" fill="url(#bodyRight)"/>
          <ellipse cx="299" cy="539" rx="55" ry="23" fill="url(#bodyRight)"/>
        </g>

        <ellipse cx="216" cy="208" rx="101" ry="52" fill="url(#bodyRight)"/>
        <ellipse cx="216" cy="249" rx="116" ry="56" fill="url(#bodyRight)"/>
        <ellipse cx="216" cy="294" rx="126" ry="60" fill="url(#bodyRight)"/>
        <ellipse cx="216" cy="341" rx="118" ry="57" fill="url(#bodyRight)"/>
        <ellipse cx="216" cy="384" rx="101" ry="50" fill="url(#bodyRight)"/>

        <g class="catch-arm-left" transform-origin="132px 241px">
          <ellipse cx="126" cy="238" rx="40" ry="47" fill="url(#bodyRight)"/>
          <ellipse cx="91" cy="256" rx="37" ry="44" fill="url(#bodyRight)"/>
          <ellipse cx="60" cy="279" rx="34" ry="40" fill="url(#bodyRight)"/>
          <ellipse cx="28" cy="299" rx="32" ry="27" fill="url(#bodyRight)"/>
          <circle cx="8" cy="291" r="9" fill="url(#bodyRight)"/>
          <circle cx="9" cy="307" r="8" fill="url(#bodyRight)"/>
        </g>
        <g class="catch-arm-right" transform-origin="296px 250px">
          <ellipse cx="302" cy="245" rx="40" ry="47" fill="url(#bodyRight)"/>
          <ellipse cx="335" cy="266" rx="36" ry="43" fill="url(#bodyRight)"/>
          <ellipse cx="364" cy="289" rx="32" ry="38" fill="url(#bodyRight)"/>
          <ellipse cx="390" cy="306" rx="30" ry="25" fill="url(#bodyRight)"/>
        </g>

        <path d="M154 158 C141 116 154 68 191 42 C225 18 274 25 299 59 C321 89 317 129 293 157 C269 184 231 196 196 187 C175 182 160 171 154 158Z" fill="url(#faceRight)"/>
        <ellipse cx="198" cy="103" rx="15" ry="21" fill="#fff" stroke="#9aa6b5" stroke-width="3"/>
        <ellipse cx="253" cy="101" rx="15" ry="21" fill="#fff" stroke="#9aa6b5" stroke-width="3"/>
        <ellipse cx="199" cy="106" rx="7" ry="11" fill="#0b1220"/>
        <ellipse cx="251" cy="104" rx="7" ry="11" fill="#0b1220"/>
        <circle cx="196" cy="101" r="2.5" fill="#fff"/>
        <circle cx="248" cy="99" r="2.5" fill="#fff"/>
        <path d="M187 138 Q226 165 267 133" fill="none" stroke="#273244" stroke-width="5" stroke-linecap="round"/>
        <path d="M211 122 Q224 129 237 121" fill="none" stroke="#9aa6b5" stroke-width="3" stroke-linecap="round"/>

        <g transform="rotate(31 216 268)">
          <rect x="106" y="241" width="222" height="44" rx="17" fill="#003b8f" stroke="#ffd900" stroke-width="4"/>
          <text x="217" y="271" text-anchor="middle" fill="#fff" font-size="28" font-weight="900" font-family="Arial, Helvetica, sans-serif">MICHELIN</text>
        </g>
      </g>
    </svg>
  </div>

  <div class="tire-lane" aria-label="TBL2 tire rolling between the two Bibendum figures">
    <div class="tire-ghost ghost-a"></div>
    <div class="tire-ghost ghost-b"></div>
    <div class="tire-carrier">
      <div class="tire">
        <div class="hub"><span>TBL2</span></div>
      </div>
    </div>
  </div>

  <div class="ground-glow"></div>
</section>

<style>
.bibendum-shell {
  position:absolute;
  inset:0;
  overflow:hidden;
  color:#f8fbff;
  background:
    radial-gradient(circle at 50% 60%, rgba(0,86,179,.35), transparent 48%),
    linear-gradient(135deg,#051025,#07162b);
}

.headline {
  position:absolute;
  left:72px;
  top:60px;
  z-index:20;
}
.headline p {
  margin:0 0 12px;
  color:#ffd900;
  letter-spacing:.08em;
  font-size:28px;
  font-style:italic;
  font-weight:950;
}
.headline h2 {
  margin:0;
  max-width:1050px;
  font-size:clamp(48px,4.6vw,78px);
  line-height:.94;
  letter-spacing:-.055em;
}

.speed-halo {
  position:absolute;
  left:50%;
  top:58%;
  width:840px;
  height:470px;
  transform:translate(-50%,-50%);
  border-radius:50%;
  background:radial-gradient(circle,rgba(39,156,255,.34),rgba(0,94,210,.12) 48%,transparent 72%);
  filter:blur(8px);
}
.speed-line {
  position:absolute;
  left:28%;
  width:44%;
  height:3px;
  border-radius:999px;
  background:linear-gradient(90deg,transparent,#3bb5ff,transparent);
  opacity:.55;
  transform-origin:center;
  animation:linePulse 2.4s ease-in-out infinite;
}
.s1 { top:61%; transform:rotate(-4deg); }
.s2 { top:66%; transform:rotate(1deg); animation-delay:.35s; }
.s3 { top:71%; transform:rotate(5deg); animation-delay:.7s; }

.bibendum-wrap {
  position:absolute;
  bottom:22px;
  width:460px;
  height:650px;
  z-index:9;
}
.left-bib { left:24px; }
.right-bib { right:24px; }
.bibendum-svg { width:100%; height:100%; overflow:visible; }
.bib-bob { animation:bibBob 3.8s ease-in-out infinite; transform-origin:50% 80%; }
.right-bob { animation-delay:.4s; }
.throw-arm { animation:throwArm 5.2s ease-in-out infinite; }
.catch-arm-left { animation:catchLeft 5.2s ease-in-out infinite; }
.catch-arm-right { animation:catchRight 5.2s ease-in-out infinite; }

.tire-lane {
  position:absolute;
  left:395px;
  right:395px;
  bottom:230px;
  height:220px;
  z-index:12;
  pointer-events:none;
}
.tire-carrier {
  position:absolute;
  left:0;
  bottom:16px;
  width:178px;
  height:178px;
  animation:tireTravel 5.2s cubic-bezier(.42,.02,.58,.98) infinite alternate;
}
.tire {
  position:relative;
  width:178px;
  height:178px;
  border-radius:50%;
  background:
    repeating-radial-gradient(circle at center,transparent 0 58px,rgba(255,255,255,.08) 60px 62px,transparent 64px 70px),
    radial-gradient(circle at center,#10151d 0 34%,#070a0f 35% 53%,#252a32 54% 61%,#050607 62% 100%);
  border:11px solid #242933;
  box-shadow:0 18px 36px rgba(0,0,0,.46), inset 0 0 0 3px rgba(255,255,255,.05),0 0 36px rgba(55,170,255,.16);
  animation:tireSpin .92s linear infinite;
}
.tire::before {
  content:"";
  position:absolute;
  inset:-8px;
  border-radius:50%;
  border:7px dashed rgba(255,255,255,.21);
}
.tire::after {
  content:"";
  position:absolute;
  inset:15px;
  border-radius:50%;
  border:2px solid rgba(255,255,255,.09);
}
.hub {
  position:absolute;
  inset:37px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:radial-gradient(circle at 35% 28%,#fff170 0,#ffe02a 34%,#ffd900 69%,#d3ae00 100%);
  border:4px solid #b78f00;
  box-shadow:inset 0 0 18px rgba(255,255,255,.4),0 0 25px rgba(255,217,0,.27);
}
.hub span {
  color:#003b8f;
  font-weight:1000;
  font-size:34px;
  letter-spacing:-.07em;
  font-style:italic;
}
.tire-ghost {
  position:absolute;
  bottom:38px;
  width:130px;
  height:130px;
  border:14px solid rgba(66,176,255,.18);
  border-radius:50%;
  opacity:0;
  filter:blur(2px);
  animation:ghostTravel 5.2s linear infinite alternate;
}
.ghost-a { animation-delay:-.22s; }
.ghost-b { animation-delay:-.42s; opacity:.09; }

.ground-glow {
  position:absolute;
  left:9%;
  right:9%;
  bottom:62px;
  height:80px;
  border-radius:50%;
  background:radial-gradient(ellipse,rgba(40,150,255,.26),transparent 68%);
  filter:blur(10px);
}

@keyframes tireTravel {
  0% { left:0; transform:translateY(0) scale(.94); }
  8% { transform:translateY(-18px) scale(1.02); }
  48% { transform:translateY(-2px) scale(1); }
  92% { transform:translateY(-18px) scale(1.02); }
  100% { left:calc(100% - 178px); transform:translateY(0) scale(.94); }
}
@keyframes tireSpin { to { transform:rotate(360deg); } }
@keyframes ghostTravel {
  0% { left:8%; opacity:.05; transform:scale(.84); }
  50% { opacity:.16; }
  100% { left:calc(92% - 130px); opacity:.05; transform:scale(.84); }
}
@keyframes bibBob {
  0%,100% { transform:translateY(0) rotate(0deg); }
  50% { transform:translateY(-5px) rotate(.4deg); }
}
@keyframes throwArm {
  0%,12% { transform:rotate(-4deg); }
  18% { transform:rotate(-15deg); }
  27%,100% { transform:rotate(2deg); }
}
@keyframes catchLeft {
  0%,72% { transform:rotate(5deg); }
  84% { transform:rotate(-9deg); }
  100% { transform:rotate(2deg); }
}
@keyframes catchRight {
  0%,72% { transform:rotate(-5deg); }
  84% { transform:rotate(9deg); }
  100% { transform:rotate(-2deg); }
}
@keyframes linePulse {
  0%,100% { opacity:.18; transform:scaleX(.92); }
  50% { opacity:.72; transform:scaleX(1.05); }
}

@media (max-width:1500px) {
  .bibendum-wrap { width:390px; height:570px; bottom:30px; }
  .left-bib { left:-12px; }
  .right-bib { right:-12px; }
  .tire-lane { left:315px; right:315px; bottom:205px; }
  .headline h2 { max-width:820px; font-size:60px; }
}

@media (prefers-reduced-motion: reduce) {
  .tire-carrier,.tire,.tire-ghost,.bib-bob,.throw-arm,.catch-arm-left,.catch-arm-right,.speed-line { animation:none; }
  .tire-carrier { left:calc(50% - 89px); }
}
</style>

<style>
.map-shell { width:100%; height:100%; min-height:620px; padding:54px; border-radius:30px; overflow:hidden; background:radial-gradient(circle at 50% 60%, rgba(0,86,179,.35), transparent 48%),linear-gradient(135deg,#051025,#07162b); color:#f8fbff; }
